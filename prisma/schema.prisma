datasource db {
  provider = "postgresql"
}



generator client {
  provider = "prisma-client-js"
}

model User {
  username             String             @id @db.VarChar(50)
  email                String             @unique
  passwordHash         String
  avatarUrl            String?
  emailVerified        Boolean            @default(false)
  passwordChangedAt    DateTime?
  sessionInvalidatedAt DateTime?
  createdAt            DateTime           @default(now())
  sessions             Session[]
  verificationCodes    VerificationCode[]
}

model Session {
  id                String   @id @default(uuid())
  userId            String?  @db.VarChar(50)
  user              User?    @relation(fields: [userId], references: [username], onDelete: Cascade)
  guestDisplayName  String?
  practiceSessionId String?  @unique
  mode              String
  grossWpm          Int
  netWpm            Int
  accuracy          Float
  timeTakenSeconds  Float
  charsTyped        Int      @default(0)
  mistakes          Int      @default(0)
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([mode])
}

model PracticeSession {
  id               String   @id @default(uuid())
  targetText       String
  mode             String
  userId           String?  @db.VarChar(50)
  guestDisplayName String?
  startedAt        DateTime @default(now())
  expiresAt        DateTime
  completed        Boolean  @default(false)
}

model VerificationCode {
  id        String   @id @default(uuid())
  userId    String   @db.VarChar(50)
  user      User     @relation(fields: [userId], references: [username], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}
