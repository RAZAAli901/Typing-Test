# TypeMaster Web Environment Variables Template
# Copy this file to .env.local and fill in real values. DO NOT commit actual secrets!

# Prisma & Database Connection
# DATABASE_URL: Supabase Transaction Pooler (Port 6543) for Prisma queries (Server-Only)
DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: Supabase Direct Connection (Port 5432) for Prisma migrations (Server-Only)
DIRECT_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# NextAuth Authentication Configuration
# NEXTAUTH_URL: Base canonical URL of the application
NEXTAUTH_URL="http://localhost:3000"

# NEXTAUTH_SECRET: Secret key used to encrypt and sign JWT session tokens (Server-Only)
NEXTAUTH_SECRET="your-32-character-random-secret-key-here"

# Transactional Email Configuration
# RESEND_API_KEY: Resend API key for verification code and login notification emails (Server-Only)
RESEND_API_KEY="re_123456789_your_resend_api_key_here"

# Supabase Client API Configuration (Safe for client bundle exposure)
# NEXT_PUBLIC_SUPABASE_URL: Base URL for Supabase API and WebSocket connections
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Anonymous public API key for Realtime subscriptions
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Supabase Server API Configuration (Server-Only)
# SUPABASE_SERVICE_ROLE_KEY: Privileged service role key for storage and admin tasks (Server-Only)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"
