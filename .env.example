# Vercel Postgres database connection variables
# Copy this file to .env and fill in the values from your Vercel Project Settings.

# Database Connection URI (Prisma Client standard)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/typemaster?schema=public"

# Transaction-pooled connection string (Vercel standard)
POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/typemaster?schema=public"

# Direct connection string (used for migrations and schema diffing)
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/typemaster?schema=public"

# NextAuth session configuration options
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-32-character-random-key-here"

# Vercel Cloud Blob Storage token for avatar uploads (optional, falls back to local uploads if omitted)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_key_placeholder"
