# Vercel Postgres database connection variables
# Copy this file to .env and fill in the values from your Vercel Project Settings.

# Transaction-pooled connection string (used by Prisma client)
POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/typemaster?schema=public"

# Direct connection string (used for migrations and schema diffing)
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/typemaster?schema=public"

# Individual credentials (optional, but standard for Vercel integration)
POSTGRES_URL="postgresql://postgres:postgres@localhost:5432/typemaster"
POSTGRES_USER="postgres"
POSTGRES_HOST="localhost"
POSTGRES_PASSWORD="postgres"
POSTGRES_DATABASE="typemaster"
