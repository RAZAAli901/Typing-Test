# Supabase Database connection variables
# DATABASE_URL: Supabase Transaction Pooler (Port 6543) for Prisma queries
DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: Supabase Direct Connection (Port 5432) for Prisma migrations and schema pushes
DIRECT_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Legacy Vercel Postgres connection strings (maintained for backwards compatibility)
POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/typemaster?schema=public"
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/typemaster?schema=public"

# NextAuth session configuration options
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-32-character-random-key-here"

# Supabase Storage configuration for profile avatars (bucket: 'avatars')
# Managed via NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY

# Resend API Key for email delivery. Obtain from resend.com dashboard.
RESEND_API_KEY=""


# Supabase Server API environment variables (server-side default fallback)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Supabase Client API environment variables (SAFE for client bundle exposure)
# NEXT_PUBLIC_ prefix makes these accessible in browser components via process.env
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Supabase Service Role Key (SERVER-ONLY - DO NOT EXPOSE TO CLIENT/BROWSER)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

