# Local Development Environment Variables Example (.env.local.example)
# Copy to .env.local for local development settings

# Supabase Local / Staging connection URIs
DATABASE_URL="postgres://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgres://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Supabase Client-side credentials
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder-anon-key"

# Supabase Server-side credentials
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder-anon-key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder-service-role-key"

# Local Server Config
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="development-local-secret-key-32-chars-long!"

# Site Configuration & Metadata (Safe for client bundle exposure)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CONTACT_EMAIL="contact@example.com"
NEXT_PUBLIC_OPERATOR_NAME="TypeMaster"
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-6696399034620004"
